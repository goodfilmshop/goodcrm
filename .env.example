# The URL and publishable key identify this Supabase project. They are safe for
# the browser only because the CRM tables use Row Level Security (RLS).
SUPABASE_URL=https://mbxuebqqglaeechltkyl.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_project_key

# Optional CRM storage allocation in bytes (not the Supabase billing quota).
# Leave blank to show usage without an invented remaining-space figure.
CRM_STORAGE_QUOTA_BYTES=
CRM_STORAGE_BUCKETS=announcement-images,quotation-images

# Production traffic is accepted only when the trusted edge reports Thailand.
# For Cloudflare, leave GEO_COUNTRY_HEADER as cf-ipcountry and block direct
# origin traffic; see SECURITY_DEPLOYMENT.md.
GEO_RESTRICTION_ENABLED=true
GEO_ALLOWED_COUNTRIES=TH
GEO_COUNTRY_HEADER=cf-ipcountry
GEO_ALLOW_LOCAL_DEVELOPMENT=true

# Receive-only pilot: GFS @249izgyn. Never put these server secrets in public/.
# Keep disabled until bot identity, old webhook and live delivery are checked.
LINE_GFS_INTAKE_ENABLED=false
LINE_GFS_INTAKE_MODE=cloud
LINE_GFS_CHANNEL_SECRET=
LINE_GFS_CHANNEL_ACCESS_TOKEN=
# U... bot user ID from GET /v2/bot/info, NOT the @ basic ID.
LINE_GFS_BOT_USER_ID=
# Dedicated server-side Supabase secret/service-role credential for ingestion.
LINE_INTAKE_SUPABASE_SECRET_KEY=
